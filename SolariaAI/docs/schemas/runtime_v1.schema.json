{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solaria.local/schemas/runtime_v1.schema.json",
  "title": "Solaria HTTP inference and classroom review responses (api_v1)",
  "oneOf": [
    {"$ref": "#/$defs/health"},
    {"$ref": "#/$defs/classification"},
    {"$ref": "#/$defs/error"},
    {"$ref": "#/$defs/reviewResponse"},
    {"$ref": "#/$defs/reviewFeed"}
  ],
  "$defs": {
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "class": {"enum": ["sun", "earth", "moon", "mars", "jupiter", "venus", "saturn", "uranus", "neptune", "mercury"]},
    "qualityCode": {"enum": ["no_drawing_found", "too_blurry", "too_dark", "too_bright", "low_contrast", "drawing_too_small", "drawing_off_centre"]},
    "health": {
      "type": "object",
      "required": ["api_version", "status", "version", "service_version", "model", "model_loaded", "mock", "classes", "threshold", "thresholds", "camera_available", "queue"],
      "properties": {
        "api_version": {"const": "api_v1"},
        "status": {"enum": ["ok", "degraded"]},
        "version": {"type": "string"},
        "service_version": {"type": "string"},
        "model": {"type": "string"},
        "model_loaded": {"type": "boolean"},
        "mock": {"type": "boolean"},
        "classes": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/class"}},
        "threshold": {"$ref": "#/$defs/probability"},
        "thresholds": {"type": "object", "required": ["confidence", "quality"], "properties": {"confidence": {"$ref": "#/$defs/probability"}, "quality": {"type": "object"}}},
        "camera_available": {"const": false},
        "queue": {"type": "object", "required": ["pending", "in_flight", "capacity", "workers", "timed_out"], "properties": {
          "pending": {"type": "integer", "minimum": 0},
          "in_flight": {"type": "integer", "minimum": 0},
          "capacity": {"type": "integer", "minimum": 0},
          "workers": {"type": "integer", "minimum": 1},
          "timed_out": {"type": "integer", "minimum": 0}
        }}
      }
    },
    "classification": {
      "type": "object",
      "required": ["api_version", "request_id", "mock", "quality", "label", "confidence", "accepted", "threshold", "reason_code", "top3", "thumbnail", "elapsed_ms"],
      "properties": {
        "api_version": {"const": "api_v1"},
        "request_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "scan_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "mock": {"type": "boolean"},
        "quality": {"type": "object", "required": ["status", "reason_code", "hint"], "properties": {
          "status": {"enum": ["pass", "fail"]},
          "reason_code": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/qualityCode"}]},
          "hint": {"type": "string", "minLength": 1}
        }},
        "label": {"anyOf": [{"$ref": "#/$defs/class"}, {"const": "unknown"}]},
        "confidence": {"$ref": "#/$defs/probability"},
        "accepted": {"type": "boolean"},
        "threshold": {"$ref": "#/$defs/probability"},
        "reason_code": {"anyOf": [{"type": "null"}, {"const": "CONF_BELOW_THRESHOLD"}, {"$ref": "#/$defs/qualityCode"}]},
        "top3": {"type": "array", "maxItems": 3, "items": {"type": "object", "required": ["label", "confidence"], "properties": {"label": {"$ref": "#/$defs/class"}, "confidence": {"$ref": "#/$defs/probability"}}}},
        "thumbnail": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["content_type", "base64"], "properties": {"content_type": {"const": "image/png"}, "base64": {"type": "string", "minLength": 1}}}]},
        "elapsed_ms": {"type": "number", "minimum": 0}
      },
      "allOf": [{"if": {"properties": {"accepted": {"const": true}}}, "then": {"properties": {"label": {"$ref": "#/$defs/class"}, "reason_code": {"type": "null"}, "quality": {"properties": {"status": {"const": "pass"}}}}}, "else": {"properties": {"label": {"const": "unknown"}}}}]
    },
    "review": {
      "type": "object",
      "required": ["scan_id", "student_id", "received_at", "prediction", "revision", "final_label", "accepted", "decider", "overrides"],
      "additionalProperties": false,
      "properties": {
        "scan_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "student_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "received_at": {"type": "string", "format": "date-time"},
        "prediction": {"$ref": "#/$defs/classification"},
        "revision": {"type": "integer", "minimum": 0, "maximum": 20},
        "final_label": {"anyOf": [{"$ref": "#/$defs/class"}, {"const": "unknown"}]},
        "accepted": {"type": "boolean"},
        "decider": {"enum": ["ai", "teacher"]},
        "application": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["revision", "status"], "properties": {"revision": {"type": "integer", "minimum": 1, "maximum": 20}, "status": {"enum": ["waiting_student", "ready", "rejected"]}}}]},
        "overrides": {"type": "array", "maxItems": 20, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["label", "note", "at", "revision", "decider"],
          "properties": {
            "label": {"$ref": "#/$defs/class"},
            "accepted": {"type": "boolean"},
            "note": {"type": "string", "maxLength": 500},
            "at": {"type": "string", "format": "date-time"},
            "revision": {"type": "integer", "minimum": 1, "maximum": 20},
            "decider": {"const": "teacher"}
          }
        }}
      }
    },
    "reviewResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_version", "review"],
      "properties": {"api_version": {"const": "api_v1"}, "review": {"$ref": "#/$defs/review"}}
    },
    "reviewFeed": {
      "type": "object", "additionalProperties": false,
      "required": ["api_version", "reviews", "retention"],
      "properties": {
        "api_version": {"const": "api_v1"},
        "reviews": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/review"}},
        "retention": {"type": "object", "additionalProperties": false,
          "required": ["capacity", "ttl_seconds", "persistent"],
          "properties": {"capacity": {"const": 200}, "ttl_seconds": {"const": 7200}, "persistent": {"const": false}}
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["api_version", "reason_code", "message"],
      "properties": {
        "api_version": {"const": "api_v1"},
        "reason_code": {"enum": ["UNAUTHORIZED", "NOT_FOUND", "INPUT_INVALID", "INPUT_TOO_LARGE", "LABEL_NOT_IN_CLASSES", "QUEUE_FULL", "SERVICE_UNAVAILABLE", "MODEL_UNAVAILABLE", "SCAN_TIMEOUT", "INTERNAL_ERROR", "REVIEW_CONFLICT", "QUALITY_REJECTED"]},
        "message": {"type": "string", "minLength": 1},
        "retry_after_ms": {"type": "integer", "minimum": 1}
      }
    }
  }
}
