{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solaria.local/schemas/api_v1.schema.json",
  "title": "Solaria api_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "status",
    "prediction",
    "review",
    "build_result"
  ],
  "properties": {
    "version": {"const": "api_v1"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "rejected", "failed"]},
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "label",
        "confidence",
        "accepted",
        "reason",
        "threshold",
        "model_artifact",
        "metadata_artifact"
      ],
      "properties": {
        "version": {"const": "prediction_v1"},
        "label": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "accepted": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "model_artifact": {"type": "string", "minLength": 1},
        "metadata_artifact": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "predicted_label",
        "final_label",
        "action",
        "override",
        "reviewer",
        "notes"
      ],
      "properties": {
        "version": {"const": "review_v1"},
        "predicted_label": {"type": "string", "minLength": 1},
        "final_label": {"type": ["string", "null"], "minLength": 1},
        "action": {"enum": ["confirm", "override", "reject"]},
        "override": {"type": "boolean"},
        "reviewer": {"type": "string", "minLength": 1},
        "notes": {"type": ["string", "null"]}
      }
    },
    "build_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "message",
        "artifact"
      ],
      "properties": {
        "version": {"const": "build_result_v1"},
        "status": {"enum": ["completed", "failed", "not_attempted"]},
        "message": {"type": ["string", "null"]},
        "artifact": {"type": ["string", "null"]}
      }
    }
  }
}
